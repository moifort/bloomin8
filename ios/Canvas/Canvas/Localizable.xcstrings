    },
    "Le Canvas garde ses photos actuelles tant que vous ne remplacez pas l'album. Annuler supprime les photos déjà envoyées." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Canvas keeps its current photos until you replace the album. Cancel deletes the photos already uploaded."
