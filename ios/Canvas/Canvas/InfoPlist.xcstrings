      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvas connects to your server and your frame on the local network to send photos and follow the playlist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvas se connecte à votre serveur et à votre cadre sur le réseau local pour envoyer les photos et suivre la playlist."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvas needs access to your albums to convert the photos and send them to the frame."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvas a besoin d'accéder à vos albums pour convertir les photos et les envoyer au cadre."
